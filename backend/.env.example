# Copy to .env before running.
PORT=4000

# Max upload size for posts, in MB (images and short video clips)
MAX_UPLOAD_MB=50

# Firebase Admin service account, used to verify the ID tokens the client
# gets from Firebase Auth. Get these from:
# Firebase console → Project settings → Service accounts → Generate new
# private key (downloads a JSON file — copy the three fields below out of it).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and the literal \n line breaks exactly as they appear
# in the downloaded JSON's "private_key" field.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Database (Turso — free forever, survives host restarts) ---
# Leave both blank for local dev: the app falls back to a local SQLite
# file automatically. Fill these in for production.
# Get them with the Turso CLI: `turso db show <db-name> --url` and
# `turso db tokens create <db-name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- File storage (Backblaze B2 — free forever, 10GB, no card required) ---
# Backblaze dashboard -> App Keys -> "Add a New Application Key" (give it
# Read & Write access to your bucket). Keep the bucket set to Private —
# B2 only requires a card on file for Public buckets, and the app serves
# files itself through the /files route (see routes/files.js), so the
# bucket never needs to be Public.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# The S3-compatible endpoint shown on your bucket's "S3 Compatible API"
# info (no https://, no bucket name), e.g. s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
