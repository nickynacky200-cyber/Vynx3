# Copy to .env before running.
PORT=4000

# Max upload size for posts, in MB (images and short video clips)
MAX_UPLOAD_MB=50

# Firebase Admin service account, used to verify the ID tokens the client
# gets from Firebase Auth. Get these from:
# Firebase console → Project settings → Service accounts → Generate new
# private key (downloads a JSON file — copy the three fields below out of it).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and the literal \n line breaks exactly as they appear
# in the downloaded JSON's "private_key" field.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Web Push (browser notifications for messages/likes/follows). Generate a
# real pair before launch — this is only a placeholder pair.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Only needed on hosts with a mounted persistent disk (e.g. Render's paid
# Disk feature). Leave unset for local dev — it falls back to folders
# inside this project.
DB_PATH=/var/data/vynx.db
UPLOADS_DIR=/var/data/uploads

# Free key from https://www.pexels.com/api — used by scripts/daily-post-scheduler.js
# to pull real photos/videos for the feed before you have real users posting.
PEXELS_API_KEY=your-pexels-api-key
